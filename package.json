{
  "name": "finora",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:start": "bash scripts/local/start.sh",
    "test:e2e": "node --env-file=.env.local node_modules/@playwright/test/cli.js test",
    "sync": "node --env-file=.env.local --import tsx scripts/sync.ts",
    "jobs": "node --env-file=.env.local --import tsx scripts/scheduler.ts",
    "test:integration": "node --env-file=.env.local --import tsx scripts/integration-test.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.0.0",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.90.0",
    "@tanstack/react-query": "^5.0.0",
    "decimal.js": "^10.6.0",
    "fast-xml-parser": "^5.0.0",
    "fflate": "^0.8.3",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.0.0",
    "recharts": "^3.0.0",
    "undici": "^7.30.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  },
  "type": "module",
  "engines": {
    "node": "24.x"
  }
}
